<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The render server (ServerControlActivity / MobileGLServerService /
         MobileGLDisplayActivity): a TCP listener kept alive by a wake lock in a data-sync
         foreground service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The two permissions that decide whether the server survives a dozing phone: the
         notification one lets the foreground service show the notification that is its reason to
         exist (Android 13+), and the exemption one is what the user grants from the control screen
         so the system stops freezing the process. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:hasCode="true"
        android:label="${appLabel}"
        android:theme="@style/Theme.MobileGLPlugin">

        <activity
            android:name=".PostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:theme="@style/Theme.MobileGLPlugin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PluginActivity"
            android:exported="true"
            android:theme="@style/Theme.MobileGLPlugin.NoDisplay" />

        <!-- Render server control screen: start/stop the offscreen TCP supervisor
             (MobileGLServerService) or the on-screen display server. Not a launcher: the
             bottom navigation bar (NavBar) switches between it and PostActivity. Both flavors
             ship the server (libMobileGLServer.so + the display server's JNI in libMobileGL.so).
             serverComponentsExported: the trace flavor is a debuggable dev APK that adb drives by
             explicit component (listen/token/env/onscreen/start/stop extras), so it exports
             them. The plugin flavor ships to users, and an exported component would let any app
             on the device start a server with an env of its own choosing. singleTop delivers the
             adb extras to a running screen through onNewIntent. -->
        <activity
            android:name=".ServerControlActivity"
            android:exported="${serverComponentsExported}"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MobileGLPlugin" />
        <service
            android:name=".MobileGLServerService"
            android:exported="${serverComponentsExported}"
            android:foregroundServiceType="dataSync"
            android:process=":mglsrv" />
        <!-- P11 B1 (CONTRACT-P11 B1): the connection broker for a same-device GL client in another
             security context (Termux, adb shell, another app), reached by ExternalClientHelper - an
             app_process under the client's uid - in an explicit broadcast. It checks the IPC token
             against the running server's, connects twice to the server's own unix endpoint (which
             SELinux lets only this app do) and hands the client ends back over Binder. EXPORTED IN
             BOTH FLAVOURS: that is the point of it, and the token is the guard (a server started
             without a token of at least 16 bytes hands out nothing). In the server's own process,
             where the running service's endpoint and token are; it never starts the server. -->
        <receiver
            android:name=".ExternalClientBroker"
            android:exported="true"
            android:process=":mglsrv" />
        <!-- P12 (on-screen server window): the ON-SCREEN display server. Its own process (:mglwin)
             runs the TCP server on a thread and renders a headless client's window surface
             (MOBILEGL_IPC_SURFACE=server) onto its SurfaceView. One server at a time: starting it
             stops MobileGLServerService, starting the service kills :mglwin. Software window
             rendering keeps HWUI off EGL here (Espryt's teardown terminates the default display);
             configChanges keeps the Surface through rotation and overlay changes. -->
        <activity
            android:name=".MobileGLDisplayActivity"
            android:configChanges="@integer/trace_replay_config_changes"
            android:exported="${serverComponentsExported}"
            android:hardwareAccelerated="false"
            android:launchMode="singleTop"
            android:process=":mglwin"
            android:taskAffinity="${applicationId}.mglwin"
            android:theme="@style/Theme.MobileGLPlugin" />

        <!-- One benchmark run per process: the backend is latched at MobileGL
             init and Espryt teardown kills the process-default EGL display, so
             the bench must never share a process with the POST UI. The service
             exits after each run. -->
        <service
            android:name=".BenchService"
            android:exported="false"
            android:process=":bench" />

        <meta-data
            android:name="fclPlugin_V2"
            android:resource="@string/config" />
        <meta-data
            android:name="mobilegl_backend_type_title"
            android:resource="@string/mobilegl_backend_type_title" />
        <meta-data
            android:name="mobilegl_disable_timerquery_title"
            android:resource="@string/mobilegl_disable_timerquery_title" />
        <meta-data
            android:name="mobilegl_disable_subgroup_title"
            android:resource="@string/mobilegl_disable_subgroup_title" />
        <meta-data
            android:name="mobilegl_magma_r11g11b10f_fallback_title"
            android:resource="@string/mobilegl_magma_r11g11b10f_fallback_title" />
        <meta-data
            android:name="mobilegl_magma_frames_inflight_title"
            android:resource="@string/mobilegl_magma_frames_inflight_title" />
        <meta-data
            android:name="mobilegl_avoid_sampler_mipmap_min_filter_title"
            android:resource="@string/mobilegl_avoid_sampler_mipmap_min_filter_title" />
        <meta-data
            android:name="mobilegl_coherent_as_flush_title"
            android:resource="@string/mobilegl_coherent_as_flush_title" />
        <meta-data
            android:name="mobilegl_use_angle_title"
            android:resource="@string/mobilegl_use_angle_title" />

        <meta-data
            android:name="fclPlugin"
            android:value="true" />
        <meta-data
            android:name="des"
            android:value="${des}" />
        <meta-data
            android:name="renderer"
            android:value="${renderer}" />
        <meta-data
            android:name="boatEnv"
            android:value="${boatEnv}" />
        <meta-data
            android:name="pojavEnv"
            android:value="${pojavEnv}" />
    </application>

</manifest>
